enum OfferType {
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_SHIPPING
  BUY_ONE_GET_ONE
  FREE_TRIAL
  BUNDLE_DEAL
}

enum OfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SCHEDULED
}

model SpecialOffer {
  id String @id @default(uuid())

  // Basic info
  title       String // "Özel Teklif! %50 İndirim"
  subtitle    String? // "Sınırlı süre için geçerli"
