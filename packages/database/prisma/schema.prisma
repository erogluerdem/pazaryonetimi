// ==================== ADVANCED SUPPORT CENTER / HELP DESK ====================

enum ForumSupportTicketStatus {
  NEW
  OPEN
  PENDING
  WAITING_FOR_CUSTOMER
  WAITING_FOR_THIRD_PARTY
  RESOLVED
  CLOSED
  ARCHIVED
  MERGED
}

enum ForumSupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum ForumSupportTicketType {
  QUESTION
  PROBLEM
  INCIDENT
  TASK
  BUG
  FEATURE_REQUEST
  REFUND
  COMPLAINT
  FEEDBACK
  TECHNICAL
  BILLING
  ACCOUNT
  VERIFICATION
}

enum ForumSupportChannel {
  WEB_FORM
  EMAIL
  CHAT
  PHONE
  API
  FORUM_POST
  SOCIAL_MEDIA
  MOBILE_APP
  WIDGET
}

model ForumSupportDepartment {
  id String @id @default(uuid())

  name        String
  description String? @db.Text
  slug        String  @unique

  // Display
  icon         String?
  color        String  @default("blue")
  displayOrder Int     @default(0)

  // Email integration
  email             String? // Support email for this department
  autoReplyEnabled  Boolean @default(true)
  autoReplyTemplate String? @db.Text

  // Working hours
  businessHours Json? // { monday: { start: "09:00", end: "18:00" }, ... }
  timezone      String @default("Europe/Istanbul")

  // Escalation
  escalationHours Int? // Auto-escalate after X hours
  managerId       String? // Department manager

  // Related
  categories ForumSupportCategory[]
  agents     ForumSupportAgent[]
  tickets    ForumSupportTicket[]

  // Settings
  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
}

model ForumSupportCategory {
  id String @id @default(uuid())

  departmentId String
  department   ForumSupportDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name        String
  description String?
  slug        String  @unique

  // Display
  icon         String?
  color        String  @default("gray")
  displayOrder Int     @default(0)

  // Auto-assignment
  defaultAssigneeId String? // Default agent
  autoReplyTemplate String? @db.Text

  // Form fields required for this category
  customFields Json? // [{ name: "orderId", required: true, type: "text" }]

  // SLA
  responseTimeMinutes Int? // First response SLA
  resolutionTimeHours Int? // Resolution SLA

  // Relations
  tickets       ForumSupportTicket[]
  articles      ForumHelpArticle[]
  faqs          ForumFaq[]
  faqCategories ForumFaqCategory[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([slug])
  @@index([isActive])
}

model ForumSupportAgent {
  id String @id @default(uuid())

  userId String           @unique
  user   ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Departments
  departmentId String?
  department   ForumSupportDepartment? @relation(fields: [departmentId], references: [id])

  // Agent info
  title     String? // "Senior Support", "Technical Lead"
  signature String? @db.Text

  // Skills
  skills     String[] // ["technical", "billing", "api"]
  languages  String[] // ["tr", "en"]
  maxTickets Int      @default(10)

  // Work schedule
  isAvailable  Boolean @default(true)
  workingHours Json? // Custom schedule if different from department

  // Performance
  rating            Float? // Average customer rating
  ticketsResolved   Int    @default(0)
  ticketsAssigned   Int    @default(0)
  avgResponseTime   Int? // Minutes
  avgResolutionTime Int? // Hours

  // Notification preferences
  emailOnNewTicket Boolean @default(true)
  emailOnReply     Boolean @default(true)
  pushEnabled      Boolean @default(true)

  // Status
  status String @default("active") // active, away, offline, suspended

  // Relations
  assignedTickets ForumSupportTicket[]         @relation("TicketAssignee")
  createdTickets  ForumSupportTicket[]         @relation("TicketCreator")
  replies         ForumSupportTicketReply[]
  internalNotes   ForumSupportInternalNote[]
  cannedResponses ForumSupportCannedResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([isAvailable])
  @@index([status])
}

model ForumSupportTicket {
  id String @id @default(uuid())

  // Ticket number for reference
  ticketNumber String @unique

  // Requester
  userId String
  user   ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Category & Department
  categoryId String
  category   ForumSupportCategory @relation(fields: [categoryId], references: [id])

  departmentId String
  department   ForumSupportDepartment @relation(fields: [departmentId], references: [id])

  // Assignment
  assigneeId String?
  assignee   ForumSupportAgent? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  // Creator (if created by agent on behalf of user)
  creatorId String?
  creator   ForumSupportAgent? @relation("TicketCreator", fields: [creatorId], references: [id])

  // Content
  subject         String
  description     String @db.Text
  descriptionHtml String @db.Text

  // Type & Priority
  type     ForumSupportTicketType     @default(QUESTION)
  priority ForumSupportTicketPriority @default(NORMAL)
  status   ForumSupportTicketStatus   @default(NEW)

  // Source
  channel   ForumSupportChannel @default(WEB_FORM)
  sourceIp  String?
  userAgent String?

  // Custom fields based on category
  customFields Json?

  // Related content
  orderId        String?
  productId      String?
  attachmentUrls String[]

  // Timestamps & SLA
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime? // When agent first replied
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedAt      DateTime?
  dueAt           DateTime? // SLA deadline

  // Satisfaction
  rating        Int? // 1-5 stars
  ratingComment String?   @db.Text
  ratedAt       DateTime?

  // Flags
  isSpam      Boolean @default(false)
  isInternal  Boolean @default(false) // Internal ticket
  isEscalated Boolean @default(false)

  // Merge tracking
  mergedIntoId    String?
  mergedTicketIds String[] // IDs of tickets merged into this one

  // Relations
  replies       ForumSupportTicketReply[]
  internalNotes ForumSupportInternalNote[]
  activities    ForumSupportActivity[]
  tags          ForumSupportTag[]
  followers     ForumSupportTicketFollower[]

  // AI suggestions
  suggestedArticles ForumHelpArticle[] @relation("TicketSuggestedArticles")

  @@index([userId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([dueAt])
}

model ForumSupportTicketReply {
  id String @id @default(uuid())

  ticketId String
  ticket   ForumSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Author
  userId String?
  user   ForumUserProfile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   ForumSupportAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Content
  content     String @db.Text
  contentHtml String @db.Text

  // Type
  isInternal Boolean @default(false) // Internal note vs customer reply
  isSystem   Boolean @default(false) // Auto-generated

  // Attachments
  attachmentUrls String[]

  // Draft status
  isDraft Boolean @default(false)

  // Edit tracking
  isEdited Boolean   @default(false)
  editedAt DateTime?
  editedBy String?

  // Notifications
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
}

model ForumSupportInternalNote {
  id String @id @default(uuid())

  ticketId String
  ticket   ForumSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  agentId String
  agent   ForumSupportAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  content String @db.Text

  // Note type
  type String @default("general") // general, escalation, resolution, handoff

  // Visibility
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([agentId])
}

model ForumSupportActivity {
  id String @id @default(uuid())

  ticketId String
  ticket   ForumSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Actor
  userId  String?
  agentId String?
  system  Boolean @default(false)

  // Action
  action      String // created, assigned, status_changed, replied, closed, reopened, merged, etc.
  description String?

  // Old and new values for changes
  oldValue String?
  newValue String?

  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model ForumSupportTag {
  id String @id @default(uuid())

  name        String  @unique
  color       String  @default("gray")
  description String?

  isActive Boolean @default(true)

  tickets ForumSupportTicket[]

