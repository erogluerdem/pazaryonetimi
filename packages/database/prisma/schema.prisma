  // What to delete
  deletePosts    Boolean @default(false) // Anonymize instead
  deleteMessages Boolean @default(true)
  deleteProfile  Boolean @default(true)

  // Keep anonymized
  anonymizePosts Boolean @default(true)

  // Status
  status String @default("requested") // requested, processing, completed

  // Request
  reason      String?
  requestedAt DateTime @default(now())

  // Admin
  reviewedBy String?
  reviewedAt DateTime?
