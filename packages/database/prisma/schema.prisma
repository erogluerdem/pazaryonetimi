  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

// ==================== SEO ANALYSIS ====================

model SeoAnalysis {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String?
  url       String?

  score Int @default(0) // 0-100

  titleScore       Int?
  descriptionScore Int?
  keywordScore     Int?
  imageScore       Int?

  issues   Json? // Array of {type, severity, message, suggestion}
  keywords Json?

  recommendations Json? // Array of suggestions

  analyzedAt DateTime @default(now())
