// ==================== SPAM PROTECTION (AI) ====================

model ForumSpamCheck {
  id String @id @default(uuid())

  // Content
  type      String // post, topic, pm, registration
  contentId String?
  content   String  @db.Text
  authorId  String
  authorIp  String?

  // Check results
  isSpam     Boolean?
  confidence Float? // 0.0 to 1.0
  reasons    String[] // ["suspicious_links", "keyword_spam", "rapid_posting"]

  // AI Analysis
  aiModel  String? // Which model checked this
  aiResult Json? // Raw AI output

  // Action taken
  action String? // blocked, flagged, allowed, shadow_banned

  // Moderator review
  reviewedBy      String?
  reviewedAt      DateTime?
  isFalsePositive Boolean? // Was it wrongly flagged?

  createdAt DateTime @default(now())

  @@index([isSpam])
  @@index([authorId])
  @@index([createdAt])
}

// ==================== AUTO-SAVE DRAFTS ====================

model ForumAutoSave {
