// ==================== PRICING RULES ====================

model PricingRule {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        String // "margin", "competitor", "dynamic", "bulk", "time-based"

  conditions Json? // When to apply
  action     Json? // What to do (e.g., {type: "percentage", value: -5})

  platforms  Json? // Apply to which platforms
  categories Json? // Apply to which categories

  isActive Boolean @default(true)
  priority Int     @default(0)

  appliedCount Int       @default(0)
  lastApplied  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@index([type])
}

// ==================== PRICE EXPERIMENTS (A/B) ====================

model PriceExperiment {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String

  name   String
  status String @default("active") // "active", "stopped", "completed"

