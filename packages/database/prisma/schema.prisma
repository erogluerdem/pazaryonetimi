  @@index([ip])
  @@index([createdAt])
}

// ==================== CUSTOM USER FIELDS ====================

model ForumCustomField {
  id String @id @default(uuid())

  name        String
  key         String  @unique
  description String?

  type    String // text, textarea, number, date, select, multiselect, url
