  user   ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notifications
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  addedAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model ForumSupportCannedResponse {
  id String @id @default(uuid())

  // Content
  title       String
  shortcut    String? // e.g., "!shipping" expands to full text
  content     String  @db.Text
  contentHtml String  @db.Text

  // Categorization
  category String? // "greeting", "closing", "technical", "billing"
  tags     String[]

  // Access
  isPersonal Boolean            @default(false) // Personal vs team shared
  agentId    String?
  agent      ForumSupportAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  departmentId String?

  // Variables support
  variables String[] // ["customer_name", "ticket_number", "order_id"]

  // Usage stats
  useCount Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortcut])
  @@index([category])
  @@index([isActive])
}

