// ==================== AI İÇERİK OPTİMİZASYONU ====================

model ContentAnalysis {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  originalTitle        String
  originalDescription  String?
  platform             String   @default("TRENDYOL")
  seoScore             Int      @default(0)
  readabilityScore     Int      @default(0)
  keywordScore         Int      @default(0)
  competitivenessScore Int      @default(0)
  overallScore         Int      @default(0)
  analysisResult       Json?
  suggestions          Json?
  detectedKeywords     Json?
  detectedIssues       Json?
  createdAt            DateTime @default(now())

  optimizations ContentOptimization[]

  @@index([tenantId])
  @@index([productId])
  @@index([platform])
}

model ContentOptimization {
  id                   String           @id @default(uuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  analysisId           String?
  analysis             ContentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  platform             String           @default("TRENDYOL")
  version              Int              @default(1)
  originalTitle        String
  originalDescription  String?
  optimizedTitle       String
  optimizedDescription String?
  keywords             Json?
  seoScoreBefore       Int              @default(0)
  seoScoreAfter        Int              @default(0)
  improvements         Json?
  tone                 String           @default("professional")
  status               String           @default("draft") // draft, approved, applied, rejected
  aiModelUsed          String?          @default("gemini-1.5-flash")
  tokenUsage           Int?             @default(0)
  appliedAt            DateTime?
  syncedToPlatform     Boolean          @default(false)
  syncResult           Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  batchItem ContentBatchItem?

  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@index([analysisId])
}

model ContentBatchJob {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  platform          String    @default("TRENDYOL")
  tone              String    @default("professional")
  status            String    @default("pending") // pending, processing, completed, failed
  totalProducts     Int       @default(0)
  processedProducts Int       @default(0)
  successCount      Int       @default(0)
  failCount         Int       @default(0)
  avgScoreBefore    Int?      @default(0)
  avgScoreAfter     Int?      @default(0)
  config            Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items ContentBatchItem[]

  @@index([tenantId])
  @@index([status])
}

model ContentBatchItem {
  id             String               @id @default(uuid())
  batchJobId     String
  batchJob       ContentBatchJob      @relation(fields: [batchJobId], references: [id], onDelete: Cascade)
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optimizationId String?              @unique
  optimization   ContentOptimization? @relation(fields: [optimizationId], references: [id], onDelete: SetNull)
  status         String               @default("pending") // pending, processing, completed, failed
  errorMessage   String?
  createdAt      DateTime             @default(now())

  @@index([batchJobId])
  @@index([productId])
}

model ContentTemplate {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  platform            String?
  category            String?
  tone                String   @default("professional")
  titleTemplate       String?
  descriptionTemplate String?
  promptTemplate      String?
  variables           Json?
  isDefault           Boolean  @default(false)
  usageCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model ContentRule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform  String
  ruleType  String // max_title_length, forbidden_words, required_keywords, description_format, etc.
  ruleName  String
  ruleValue Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, platform])
}

// ==================== DEPO YÖNETİMİ ====================

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  type      String   @default("main") // main, secondary, dropship, fulfillment
  address   String?
  city      String?
  district  String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfersFrom WarehouseTransfer[] @relation("TransferFrom")
  transfersTo   WarehouseTransfer[] @relation("TransferTo")
  stocks        WarehouseStock[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model WarehouseTransfer {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Int
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  reason          String?
  status          String    @default("completed") // pending, in_transit, completed, cancelled
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model BlogCategory {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  imageUrl        String?
  color           String?  @default("blue")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts BlogPost[]

  @@index([slug])
  @@index([isActive])
}

model BlogTag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@index([slug])
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String         @db.Text
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?

  authorId String

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])
  tags       BlogTag[]

  featuredImage    String?
  featuredImageAlt String?

  aiGeneratedContent Json?
  aiPrompt           String? @db.Text
  aiModel            String?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  readTime  Int?
  wordCount Int  @default(0)

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  shareCount   Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([createdAt])
}

model BlogComment {
  id              String   @id @default(uuid())
  postId          String
  content         String   @db.Text
  authorName      String
  authorEmail     String
  authorWebsite   String?
  status          String   @default("PENDING") // PENDING, APPROVED, SPAM, DELETED
  isAiModerated   Boolean  @default(false)
  aiToxicityScore Float?
  aiSentiment     String?
  createdAt       DateTime @default(now())

  @@index([postId])
  @@index([status])
}

