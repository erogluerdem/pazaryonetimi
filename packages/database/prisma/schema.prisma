  executionTime Int // milliseconds

  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([taskId])
  @@index([tenantId, userId])
  @@index([status])
  @@index([createdAt])
}

// ==================== AI ASSISTANT WORKFLOW BUILDER ====================

model AIAssistantWorkflow {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String

  // Workflow details
  name        String
  description String?

  // Visual canvas data
  nodes Json // Array of workflow nodes with positions
  edges Json // Array of connections between nodes

  // Trigger configuration
  triggerType    String // "manual", "scheduled", "event"
  cronExpression String?

  // Status
  isActive Boolean @default(false)

  // Execution stats
  lastRunAt    DateTime?
  runCount     Int       @default(0)
  successCount Int       @default(0)
  failureCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  executions AIAssistantWorkflowExecution[]

  @@index([tenantId, userId])
  @@index([isActive])
  @@index([triggerType])
}

model AIAssistantWorkflowExecution {
  id         String              @id @default(uuid())
  workflowId String
  workflow   AIAssistantWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String

  // Execution status
  status String // "pending", "running", "completed", "failed", "paused"

  // Execution data
  context Json? // Workflow context/variables
  logs    Json? // Execution logs for each node

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workflowId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([status])
  @@index([startedAt])
}

// ==================== AI ASSISTANT TEAM CHAT ====================

model AITeamConversation {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Conversation details
  name        String
  description String?

  // Members with roles
  members   Json // Array of { userId, role, joinedAt, permissions }
  createdBy String

  // Settings
  settings Json // { allowGuestAccess, requireApproval, maxMembers }

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages AITeamMessage[]

  @@index([tenantId])
  @@index([isActive])
  @@index([createdBy])
}

model AITeamMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   AITeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId  String
  role    String // "user", "assistant"
  content String

  // Message features
  mentions  String[] // User IDs mentioned
  replyTo   String? // Message ID being replied to
  reactions Json? // Array of { emoji, userId, timestamp }

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

// ==================== AI ASSISTANT VOICE SESSIONS ====================

model AIVoiceSession {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String

  // Session details
  status   String // "active", "paused", "ended"
  language String @default("tr")

  // Transcript
  transcript String?

  // Timing
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? // milliseconds

  createdAt DateTime @default(now())

  @@index([tenantId, userId])
  @@index([status])
  @@index([startedAt])
}

// ==================== API KEY MANAGEMENT ====================

enum ApiKeyStatus {
  active
  rotating
  revoked
  expired
}

model ApiKey {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  keyHash     String      @unique // SHA256 hash of the actual key
  prefix      String?     // First 8 chars for identification
  permissions Json        // Array of permission strings
  scopes      Json        // API scopes like ["read", "write", "admin"]

  // Status
  status   ApiKeyStatus @default(active)
  isActive Boolean      @default(true)

  // Rotation
  rotatedToId String? @unique
  rotatedTo   ApiKey?   @relation("ApiKeyRotation", fields: [rotatedToId], references: [id])
  rotatedFrom ApiKey?   @relation("ApiKeyRotation")

  // Timestamps
  lastUsed   DateTime?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokeAt   DateTime? // Grace period for rotation
  revokedAt  DateTime?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([keyHash])
  @@index([status])
  @@index([expiresAt])
  @@index([revokeAt])
}

// ==================== AUDIT LOG SYSTEM ====================

enum AuditSeverity {
  info
  warning
  critical
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  action   String       // e.g., "product.created", "user.login"
  resource String       // e.g., "product", "user"
  resourceId String?
  severity AuditSeverity @default(info)

  // Request context
  ipAddress String?
  userAgent String?

  // Change tracking
  metadata Json?    // Additional context
  before   Json?    // State before change
  after    Json?    // State after change
  changes  Json?     // Array of changed fields

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([severity])
  @@index([timestamp])
  @@index([tenantId, timestamp])
}

// ==================== COMMERCE OPS (Ürün/Stok/BuyBox/Otomasyon) ====================

model ProductBundle {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  sku           String
  description   String?
  status        String   @default("draft")
  pricingType   String   @default("percentage_off")
  pricingValue  Decimal  @default(0) @db.Decimal(12, 2)
  originalTotal Decimal? @db.Decimal(12, 2)
  finalPrice    Decimal? @db.Decimal(12, 2)
  platforms     Json?
  usageLimit    Int?
  usageCount    Int      @default(0)
  items         ProductBundleItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([status])
}

model ProductBundleItem {
  id         String        @id @default(uuid())
  bundleId   String
  bundle     ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int           @default(1)
  isOptional Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@index([bundleId])
  @@index([productId])
}

model StockAlertRule {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  criticalLevel    Int       @default(5)
  reorderLevel     Int       @default(10)
  autoPauseListing Boolean   @default(false)
  syncAllChannels  Boolean   @default(true)
  isActive         Boolean   @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([productId])
}

model BuyBoxRule {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  platform        Platform
  minMarginPct    Decimal   @default(10) @db.Decimal(5, 2)
  maxDropPct      Decimal   @default(5) @db.Decimal(5, 2)
  competitorFloor Decimal?  @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, platform])
}

model BuyBoxSnapshot {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform        Platform
  ourPrice        Decimal  @db.Decimal(12, 2)
  competitorPrice Decimal? @db.Decimal(12, 2)
  hasBuyBox       Boolean  @default(false)
  rank            Int?
  capturedAt      DateTime @default(now())

  @@index([tenantId, productId, platform])
  @@index([capturedAt])
}

// ==================== FORUM SYSTEM (vBulletin/XenForo Style) ====================

// Durable XML jobs. Checkpoints and product writes commit in the same transaction.
model DataOperation {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind             String
  status           String   @default("queued")
  payloadEncrypted String
  idempotencyKey   String
  sourceId         String?
  cursor           Int      @default(0)
  total            Int      @default(0)
  created          Int      @default(0)
  updated          Int      @default(0)
  attempts         Int      @default(0)
  availableAt      DateTime @default(now())
  leaseUntil       DateTime?
  leaseToken       String?
  error            String?
  result           Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([status, availableAt, leaseUntil])
  @@index([tenantId, createdAt])
  @@index([tenantId, sourceId, status])
}
