# AI Model Configuration
# Yapay zeka modellerini yönetmek için gerekli ayarlar

## OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo

## Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

## Google Gemini Configuration (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MODEL=gemini-2.5-flash

## Local Model Configuration (opsiyonel)
LOCAL_MODEL_BASE_URL=http://localhost:8000
LOCAL_MODEL_ID=local-model

## Database (PostgreSQL)
DATABASE_URL=postgresql://pazaryonetimi:pazaryonetimi_secret@localhost:5432/pazaryonetimi
POSTGRES_PASSWORD=pazaryonetimi_secret

## Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

## JWT
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

## Encryption (AES-256-GCM for sensitive data like API keys)
ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHAR_SECRET_KEY

## Sentry (opsiyonel)
SENTRY_DSN=

## API Configuration
API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
API_PORT=3001

## Web Configuration
# Tarayıcıdan erişilen API adresi (production: https://api.pazaryonetimi.com)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=https://pazaryonetimi.com
NEXTAUTH_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
# Auth.js v5 (Modern NextAuth) requires these:
AUTH_URL=https://pazaryonetimi.com
AUTH_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

## NOT: Kargo, Ödeme ve E-Fatura entegrasyon bilgileri artık her tenant tarafından
## veritabanında ayrı ayrı saklanır. Bu bilgileri /tenant-credentials API
## endpoint'i üzerinden yönetebilirsiniz. .env'ye eklemenize gerek yoktur.
## Desteklenen servis tipleri: SHIPPING_ARAS, SHIPPING_YURTICI, SHIPPING_MNG,
## SHIPPING_PTT, PAYMENT_IYZICO, PAYMENT_PAYTR, PAYMENT_PARAM,
## EINVOICE_FORIBA, EINVOICE_LOGO, EINVOICE_PARASUT, EINVOICE_EFINANS
##
## Opsiyonel global Aras fallback (tenant credentials tercih edilir):
# ARAS_API_URL=https://customerws.araskargo.com.tr/arascargoservice.asmx
# ARAS_API_USER=
# ARAS_API_PASSWORD=
# ARAS_CUSTOMER_CODE=

## Scheduler (production'da true olmalı)
ENABLE_SCHEDULER=false

## Production güvenlik — simüle entegrasyonlar (varsayılan: kapalı)
# ALLOW_SIMULATED_PAYMENTS=false
# ALLOW_SIMULATED_SHIPPING=false

## Seed Configuration (used by prisma db seed)
SEED_ADMIN_EMAIL=admin@pazaryonetimi.com
SEED_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SEED_USER_EMAIL=operator@pazaryonetimi.com
SEED_TENANT_NAME=PazarYönetimi
SEED_TENANT_SLUG=pazaryonetimi
SEED_TENANT_DOMAIN=app.pazaryonetimi.com

## Web Application URL (used for CORS)
WEB_URL=https://pazaryonetimi.com

## Extension Configuration
VITE_DASHBOARD_URL=https://pazaryonetimi.com/dashboard

## Platform API Keys (per-tenant in DB, these are seed defaults)
# TRENDYOL_API_KEY=
# TRENDYOL_API_SECRET=
# TRENDYOL_MERCHANT_ID=
# HEPSIBURADA_API_KEY=
# HEPSIBURADA_API_SECRET=
# HEPSIBURADA_MERCHANT_ID=
# AMAZON_API_KEY=
# AMAZON_API_SECRET=
# AMAZON_MERCHANT_ID=
# N11_API_KEY=
# N11_API_SECRET=
# N11_MERCHANT_ID=

# Pazaryeri bağlantıları / XML aktarımı
# JWT_SECRET web ve API hizmetlerinde aynı olmalıdır. ENCRYPTION_KEY değişirse mevcut anahtarlar çözülemez.
AMAZON_SP_API_APPLICATION_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Amazon uygulamasına kaydedilmiş, herkese açık tam callback adresi:
AMAZON_REDIRECT_URI=https://api.pazaryonetimi.com/api/v1/oauth/amazon/callback
HEPSIBURADA_INTEGRATOR_NAME=PazarYonetimi
TRENDYOL_INTEGRATOR_NAME=PazarYonetimi
XML_AUTO_SYNC_ENABLED=true

# Kalıcı aktarım ve yedekleme işleri
DATA_OPERATIONS_WORKER_ENABLED=true
BACKUP_WORKER_ENABLED=true
BACKUP_STORAGE_DIR=/app/var/backups
# Boşsa ENCRYPTION_KEY kullanılır; anahtarı arşivlerden ayrı yedekleyin.
BACKUP_ENCRYPTION_KEY=
# Ayrı geri yükleme sunucusunda geçici DB oluşturma/silme yetkili hesap.
RESTORE_DRILL_ADMIN_URL=
