# ============================================
# COOLIFY DEPLOYMENT ENVIRONMENT VARIABLES
# Bu dosyayı .env.coolify olarak kopyalayıp Coolify'de kullanın
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://pazaryonetimi:${POSTGRES_PASSWORD}@postgres:5432/pazaryonetimi
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_URL=https://pazaryonetimi.com
NEXTAUTH_SECRET=your_nextauth_secret_here
AUTH_URL=https://pazaryonetimi.com
AUTH_SECRET=your_auth_secret_here

# ============================================
# API
# ============================================
# Tarayıcı / istemci tarafı
NEXT_PUBLIC_API_URL=https://api.pazaryonetimi.com
# Web konteynerinden API'ye iç ağ çağrısı (Coolify servis adı)
API_INTERNAL_URL=http://api:3001
API_URL=http://api:3001
JWT_SECRET=your_jwt_secret_here

# ============================================
# SECURITY
# ============================================
# 32+ karakter rastgele string
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ============================================
# EXTERNAL SERVICES (opsiyonel)
# ============================================
# SENTRY_DSN=
# SENTRY_ORG=pazaryonetimi
# SENTRY_PROJECT=pazaryonetimi-web

# Google Gemini (AI Studio)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY=

# EMAIL SERVER
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SCHEDULER=true
NODE_ENV=production
ALLOW_SIMULATED_PAYMENTS=false
ALLOW_SIMULATED_SHIPPING=false

# ============================================
# CLEANUP SERVICE
# ============================================
CLEANUP_SCHEDULE="0 */6 * * *"

# Pazaryeri bağlantıları / XML aktarımı
# JWT_SECRET web ve API hizmetlerinde aynı olmalıdır. ENCRYPTION_KEY değişirse mevcut anahtarlar çözülemez.
AMAZON_SP_API_APPLICATION_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Amazon uygulamasına kaydedilmiş, herkese açık tam callback adresi:
AMAZON_REDIRECT_URI=https://api.pazaryonetimi.com/api/v1/oauth/amazon/callback
HEPSIBURADA_INTEGRATOR_NAME=PazarYonetimi
TRENDYOL_INTEGRATOR_NAME=PazarYonetimi
XML_AUTO_SYNC_ENABLED=true

# Kalıcı aktarım ve yedekleme işleri
DATA_OPERATIONS_WORKER_ENABLED=true
BACKUP_WORKER_ENABLED=true
BACKUP_STORAGE_DIR=/app/var/backups
# Boşsa ENCRYPTION_KEY kullanılır; anahtarı arşivlerden ayrı yedekleyin.
BACKUP_ENCRYPTION_KEY=
# Ayrı geri yükleme sunucusunda geçici DB oluşturma/silme yetkili hesap.
RESTORE_DRILL_ADMIN_URL=
